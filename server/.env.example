PORT=4000
# Change this in production and keep it secret.
JWT_SECRET=dev-secret-change-me-in-production
CORS_ORIGIN=http://localhost:5173
# SQLite file (relative to the server/data folder or an absolute path).
DB_FILE=./data/emergency.db
# Set to "true" to enable demo simulation mode for sensor data.
SIMULATION_MODE=true
# Optional API key for IoT device endpoints. Leave empty in prototype mode.
# Set a strong value in production so only your device can POST telemetry.
IOT_API_KEY=

# ---------------------------------------------------------------------------
# REAL outgoing emergency calls (Twilio Programmable Voice)
# ---------------------------------------------------------------------------
# Get these at https://console.twilio.com → Account Info + Phone Numbers.
# LEAVE EMPTY to keep calls simulated (demo mode) — nothing pretends otherwise.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# A Twilio number you own in E.164 format, e.g. +17024181234.
# For India, start with a verified caller ID or an approved Indian number.
TWILIO_FROM_NUMBER=

# The numbers that receive REAL calls when a genuine accident is confirmed.
# Comma-separated E.164. All are dialed CONCURRENTLY.
EMERGENCY_CONTACTS=+917358991015,+918248319996,+918754932145

# Public HTTPS base URL of THIS server (required for live call-status callbacks).
# e.g. https://autosafe.onrender.com  — leave empty for local/dev.
PUBLIC_BASE_URL=
# Optional shared token that protects the Twilio status webhook path.
CALL_STATUS_TOKEN=

# Spoken language order: ta-en (Tamil then English) | en | ta.
CALL_LANGUAGE=ta-en
# Retry policy for failed calls: max extra attempts + delay between them (ms).
CALL_MAX_RETRIES=1
CALL_RETRY_DELAY_MS=15000
# Seconds Twilio rings before treating the call as failed.
CALL_TIMEOUT_SECONDS=30

# TEST MODE — when "true", calls use a clearly-labelled TEST message and are
# intended only for verifying that real phones ring. Requires explicit opt-in.
EMERGENCY_TEST_MODE=false

# Backwards-compatible single number (older configs).
EMERGENCY_CALL_TO=+917358991015
