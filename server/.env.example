PORT=4000
# Change this in production and keep it secret.
JWT_SECRET=dev-secret-change-me-in-production
CORS_ORIGIN=http://localhost:5173
# SQLite file (relative to the server/data folder or an absolute path).
DB_FILE=./data/emergency.db
# Set to "true" to enable demo simulation mode for sensor data.
SIMULATION_MODE=true
# Optional API key for IoT device endpoints. Leave empty in prototype mode.
IOT_API_KEY=
# REAL outgoing emergency call (Twilio). Leave empty to keep demo calls.
# Get these at console.twilio.com → Account Info / Phone Numbers.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Number that receives the automatic call when an incident is confirmed.
EMERGENCY_CALL_TO=+917358991015
