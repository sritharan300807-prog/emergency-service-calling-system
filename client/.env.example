# Google Maps JavaScript API key.
# Get it from https://console.cloud.google.com (enable "Maps JavaScript API").
# Leave empty to fall back to the OpenStreetMap (Leaflet) map.
VITE_GOOGLE_MAPS_KEY=AIzaYOUR_KEY_HERE

# Base URL of the backend API.
# Leave EMPTY for local development / single-server builds (uses same origin).
# When the site is deployed to Vercel/Netlify, set this to your hosted backend,
# e.g. VITE_API_URL=https://autosafe-api.onrender.com
VITE_API_URL=